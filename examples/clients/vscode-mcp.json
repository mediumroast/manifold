{
  "inputs": [
    {
      "id": "manifold-credential",
      "type": "promptString",
      "description": "Your own Manifold credential (mf_...), not a shared token",
      "password": true
    }
  ],
  "servers": {
    "manifold": {
      "type": "http",
      "url": "http://127.0.0.1:8686/mcp",
      "headers": {
        "Authorization": "Bearer ${input:manifold-credential}"
      }
    }
  }
}
