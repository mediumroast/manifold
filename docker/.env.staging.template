# Staging environment variables for manifold service

# Absolute path, on this machine, of your instance repository: the folder that holds
# manifold.yaml and wiki/ (for a first try, a git-initialized copy of examples/acme).
# It is mounted into the container at /workspace.
WIKI_ROOT=/path/to/your/instance

# Absolute path of the folder for the security store (credential hashes, the audit trail) and
# Caddy's files. It is mounted at /data, owned by you, mode 0700, and must be outside WIKI_ROOT.
# ./svc_ctl.sh <env> init-env sets it (to .manifold-data/<env> in this checkout) and creates it.
DATA_DIR=


# Port for manifold service
PORT=8686

# Environment name (used for project naming and logging)
ENVIRONMENT=staging

# Address the host publishes the port on. Loopback by default; change it only
# when you also serve HTTPS (MANIFOLD_TLS=on).
BIND_ADDRESS=127.0.0.1

# TLS, served by the Caddy service: off (plain HTTP) or on (HTTPS with Caddy's local certificate
# authority; see docs/tls.md). init-env sets off for a loopback BIND_ADDRESS and on otherwise.
MANIFOLD_TLS=off

# Names and addresses the HTTPS certificate is made for (space separated). Used when MANIFOLD_TLS=on.
TLS_NAMES=localhost 127.0.0.1

# Extra Host header values the server accepts besides 127.0.0.1, localhost and [::1] on PORT, comma
# separated, for example the name or address people reach it by: 192.168.1.5:8686,wiki.example.test
ALLOWED_HOSTS=

# There is no shared token any more. Every person and agent has a credential of their own:
# ./manifold init (or ./manifold admin --env <env> credential issue ...). A shared-token line left
# in an old settings file is ignored and svc_ctl.sh warns about it; delete it.
