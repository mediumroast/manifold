# Development environment variables for manifold service

# Host path to repo root (relative to docker-compose.yml location)
# Mounts the whole repo so paths like wiki/components/*.md resolve correctly
WIKI_ROOT=..


# Port for manifold service
PORT=8686

# Environment name (used for project naming)
ENVIRONMENT=dev

# Address the host publishes the port on. Loopback by default; change it only
# when the service sits behind something that protects it.
BIND_ADDRESS=127.0.0.1

# Shared secret every client must present (Authorization: Bearer <token>). Required:
# the container listens on all interfaces, so it will not start without one.
# ./svc_ctl.sh <env> init-env generates one; to make your own use at least 24
# characters, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MANIFOLD_TOKEN=
